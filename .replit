modules = ["nodejs-20"]
run = "npm start"

[env]
PORT = "3000"

[[ports]]
localPort = 3000
externalPort = 80

[workflows]
runButton = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm start"
waitForPort = 3000

[workflows.workflow.metadata]
outputType = "webview"

[deployment]
run = "npm start"
build = "npm run build"
deploymentTarget = "cloudrun"

[nix]
channel = "stable-25_05"
packages = ["nodejs_20"]
